<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Granted by the user with adb or Shizuku, to turn accessibility services on and off. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Checks GitHub for a new version, and downloads it, when asked in the app's main screen. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Lets the app see every accessibility service, to offer them in the menu, and every text-to-speech engine. -->
    <queries>
        <intent>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opened by the service. It shows over the lock screen, since the shortcut works there. It
             is direct boot aware, like the service, so that it works after a restart before the
             phone is first unlocked. -->
        <activity
            android:name=".MenuActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/MenuTheme" />

        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

        <!-- Direct boot aware: until the phone is first unlocked after a restart, Android runs only
             the accessibility services that are, and ignores the shortcut for any other. -->
        <service
            android:name=".ShortcutMenuService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/shortcut_menu_service" />
        </service>
    </application>
</manifest>
